# Copier ce fichier en .env et renseigner de vraies valeurs (jamais commité,
# cf. .gitignore et section 9 de PROMPT-HEADER-CLAUDE.md).

# Serveur Express
PORT=3000

# Connexion PostgreSQL (utilisée par api/models/sequelize-client.js)
PGHOST=localhost
PGPORT=5432
PGDATABASE=didicecube
PGUSER=postgres
PGPASSWORD=

# Authentification JWT — générer une vraie valeur aléatoire et longue
# (ex. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`)
JWT_SECRET=

# Dossier de stockage des fichiers uploadés (skins, photos de face du cube)
UPLOAD_DIR=uploads
