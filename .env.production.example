# Modèle du .env de PRODUCTION : copier en .env sur le serveur et remplir. Ne jamais versionner .env.
# Aucune valeur réelle dans ce fichier. Voir README, « Mise en production ».

SITE_NOM=Didicecube
# Nom de domaine du site (DNS pointé vers le serveur) : Caddy obtient le certificat HTTPS pour ce nom.
DOMAINE=exemple.fr
# Générer une clé (différente de celle de développement) : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Clé de chiffrement des secrets de double authentification (différente de SECRET_KEY).
# Générer : python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Changer de clé : mettre la nouvelle en premier, garder l'ancienne après une virgule.
MFA_CLES_CHIFFREMENT=
DEBUG=false
ALLOWED_HOSTS=exemple.fr
CSRF_TRUSTED_ORIGINS=https://exemple.fr
# Préchargement HSTS : seulement quand le domaine est définitif (très difficile à annuler)
SECURE_HSTS_PRELOAD=false

# Journalisation : emails qui reçoivent chaque erreur 500
LOG_NIVEAU=INFO
ADMINS=

ROLES=administrateur
DOUBLE_AUTH_ROLES=administrateur

# Inscription libre, avec confirmation de l'adresse email avant la première connexion
INSCRIPTION_OUVERTE=true
ACCOUNT_EMAIL_VERIFICATION=mandatory

CONNEXION_ESSAIS_MAX=5
CONNEXION_BLOCAGE_SECONDES=60
CONNEXION_BLOCAGE_MAX_SECONDES=3600
CONNEXION_OUBLI_SECONDES=86400

# Base PostgreSQL (dans Docker, jamais exposée). Mot de passe long et aléatoire.
DB_NAME=didicecube
DB_USER=didicecube
DB_PASSWORD=

# Courriels réels (mot de passe oublié, erreurs 500) : serveur SMTP du fournisseur (port 587 + TLS en général)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=ne-pas-repondre@exemple.fr
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

JOURNAL_DUREE_JOURS=365

# Processus gunicorn (2 x nombre de cœurs + 1 est un bon départ) ; durée de garde des sauvegardes en jours
GUNICORN_WORKERS=3
SAUVEGARDE_JOURS=30
