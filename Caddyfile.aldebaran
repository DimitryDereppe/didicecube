# Usage : monté par docker-compose.aldebaran.yml à la place du Caddyfile.
# HTTPS est terminé par le Caddy de BookStack : ici HTTP simple, et on garde son en-tête
# X-Forwarded-Proto (https), sans quoi Django redirigerait sans fin vers HTTPS.
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Fichiers statiques copiés par collectstatic (noms avec empreinte : cache d'un an sans risque).
	handle_path /static/* {
		root * /srv/statiques
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	header -Server
}
