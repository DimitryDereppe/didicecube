# Usage : utilisé par docker-compose.prod.yml. DOMAINE vient du fichier .env.
# Caddy obtient et renouvelle seul le certificat HTTPS (Let's Encrypt) et redirige HTTP vers HTTPS.
{$DOMAINE} {
	encode zstd gzip

	# Fichiers statiques copiés par collectstatic (noms avec empreinte : cache d'un an sans risque).
	handle_path /static/* {
		root * /srv/statiques
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	header -Server
}
