# Copier en .env et remplir. Ne jamais versionner .env.
# Aucune valeur réelle dans ce fichier.

SITE_NOM=Didicecube
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Clé de chiffrement des secrets de double authentification (différente de SECRET_KEY).
# Générer : python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Changer de clé : mettre la nouvelle en premier, garder l'ancienne après une virgule.
MFA_CLES_CHIFFREMENT=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Journalisation : niveau (DEBUG, INFO, WARNING, ERROR) ; emails qui reçoivent les erreurs 500 hors debug
LOG_NIVEAU=INFO
ADMINS=

# Rôles du projet, séparés par des virgules (un groupe Django par rôle)
ROLES=administrateur
# Rôles qui doivent utiliser la double authentification (les superutilisateurs aussi, toujours)
DOUBLE_AUTH_ROLES=administrateur

# Inscription libre (false : comptes créés par un administrateur). Si true, mettre aussi
# ACCOUNT_EMAIL_VERIFICATION=mandatory (email confirmé avant la première connexion).
INSCRIPTION_OUVERTE=true
ACCOUNT_EMAIL_VERIFICATION=mandatory

# Essais de connexion par couple (email, adresse IP) : essais libres (0 = pas de limite), puis blocage
# en secondes qui double à chaque échec, plafond, et oubli du compteur sans essai pendant ce délai
CONNEXION_ESSAIS_MAX=5
CONNEXION_BLOCAGE_SECONDES=60
CONNEXION_BLOCAGE_MAX_SECONDES=3600
CONNEXION_OUBLI_SECONDES=86400

# Base PostgreSQL (DB_HOST=localhost si Django tourne hors de Docker)
DB_NAME=didicecube
DB_USER=didicecube
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Port de la base sur la machine, à changer si 5432 est déjà pris par un autre projet
DB_PORT_HOTE=5432
# Port du site sur la machine (http://localhost:8000), à changer s'il est déjà pris
WEB_PORT_HOTE=8000

# Journal d'accès : durée de conservation en jours
JOURNAL_DUREE_JOURS=365
